/* Palm Pilot Inspired Retro Design System */

/* Retro Color Palette */
:root {
  /* Classic Palm OS colors with modern adjustments */
  --palm-green: #92D050;
  --palm-dark-green: #5F8A3A;
  --palm-beige: #F5F5DC;
  --palm-dark-beige: #E8E4D0;
  --palm-gray: #8B8680;
  --palm-dark-gray: #5C5C5C;
  --palm-blue: #4A90E2;
  --palm-orange: #FF8C42;
  --palm-red: #E74C3C;
  
  /* Screen background - classic LCD green */
  --screen-bg: #9BC88B;
  --screen-border: #2C5F2D;
  
  /* Default theme - Classic Green */
  --retro-primary: #8B956D;
  --retro-secondary: #7A835C;
  --retro-background: #C5B99A;
  --retro-surface: #D4C8A8;
  --retro-text: #1A1F0F;
  --retro-text-secondary: #4A5133;
  --retro-border: #5A6143;
  --retro-button-face: #9A8B70;
  --retro-button-border: #7A6B50;
  --retro-button-highlight: #AA9B80;
  --retro-button-shadow: #6A5B40;
  --retro-status-bg: #8B956D;
  --retro-status-text: #1A1F0F;
}

:root {
  --button-face: var(--retro-button-face);
  --button-highlight: var(--retro-button-highlight);
  --button-shadow: var(--retro-button-shadow);
  --button-border: var(--retro-button-border);
  --text-primary: var(--retro-text);
  --text-secondary: var(--retro-text-secondary);
  --background: var(--retro-background);
  --surface: var(--retro-surface);
  --border: var(--retro-border);
  --primary: var(--retro-primary);
  --secondary: var(--retro-secondary);
  --text-inverse: #FFFFFF;
}

/* Retro font stack */
@import url('https://fonts.googleapis.com/css2?family=VT323&family=IBM+Plex+Mono:wght@400;500;700&family=System+UI&display=swap');

* {
  box-sizing: border-box;
}

body {
  font-family: 'IBM Plex Mono', 'System UI', monospace;
  background: linear-gradient(135deg, #2C5F2D 0%, #1a3d1a 100%);
  min-height: 100vh;
  color: var(--text-primary);
}

/* Retro device frame */
.palm-device {
  background: var(--screen-border);
  border-radius: 20px;
  padding: 12px;
  box-shadow: 
    inset 0 2px 4px rgba(0,0,0,0.8),
    0 8px 16px rgba(0,0,0,0.6),
    0 0 0 2px #1a1a1a;
  position: relative;
}

.palm-device::before {
  content: '';
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 8px;
  background: #000;
  border-radius: 4px;
  z-index: 10;
}

.palm-screen {
  background: var(--screen-bg);
  border: 3px solid var(--screen-border);
  border-radius: 8px;
  min-height: 600px;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 2px 8px rgba(0,0,0,0.3);
}

/* Scan lines effect for retro screen */
.palm-screen::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0, 0, 0, 0.1) 2px,
    rgba(0, 0, 0, 0.1) 4px
  );
  pointer-events: none;
  z-index: 1;
}

/* Enhanced Retro Buttons - Chiseled Plastic Effect */
.retro-button {
  background: linear-gradient(145deg, var(--button-highlight), var(--button-face) 40%, var(--button-shadow));
  border: 2px solid var(--button-border);
  border-radius: 4px;
  padding: 0.5rem 1rem;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.1s ease;
  box-shadow: 
    inset 1px 1px 2px rgba(255, 255, 255, 0.8),
    inset -1px -1px 2px rgba(0, 0, 0, 0.4),
    2px 2px 4px rgba(0, 0, 0, 0.6),
    -1px -1px 2px rgba(255, 255, 255, 0.4);
  position: relative;
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.6);
}

.retro-button::before {
  content: '';
  position: absolute;
  top: 1px;
  left: 1px;
  right: 1px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.8) 0%, 
    rgba(255, 255, 255, 0.4) 50%, 
    rgba(255, 255, 255, 0.8) 100%
  );
  border-radius: 2px 2px 0 0;
}

.retro-button::after {
  content: '';
  position: absolute;
  bottom: 1px;
  left: 1px;
  right: 1px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(0, 0, 0, 0.4) 0%, 
    rgba(0, 0, 0, 0.2) 50%, 
    rgba(0, 0, 0, 0.4) 100%
  );
  border-radius: 0 0 2px 2px;
}

.retro-button:hover {
  background: linear-gradient(145deg, #f0f0f0, #d0d0d0 40%, #b0b0b0);
  transform: translateY(-1px);
  box-shadow: 
    inset 1px 1px 2px rgba(255, 255, 255, 0.9),
    inset -1px -1px 2px rgba(0, 0, 0, 0.3),
    2px 3px 6px rgba(0, 0, 0, 0.7),
    -1px -2px 3px rgba(255, 255, 255, 0.5);
}

.retro-button:active {
  background: linear-gradient(145deg, #b0b0b0, #909090 40%, #707070);
  transform: translateY(1px);
  box-shadow: 
    inset 2px 2px 4px rgba(0, 0, 0, 0.6),
    inset -1px -1px 2px rgba(255, 255, 255, 0.2),
    1px 1px 2px rgba(0, 0, 0, 0.4);
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.4);
}

.retro-button:disabled {
  background: linear-gradient(145deg, #d0d0d0, #b0b0b0 40%, #909090);
  color: #808080;
  cursor: not-allowed;
  transform: none;
  box-shadow: 
    inset 1px 1px 2px rgba(255, 255, 255, 0.4),
    inset -1px -1px 2px rgba(0, 0, 0, 0.2),
    1px 1px 2px rgba(0, 0, 0, 0.2);
  text-shadow: none;
}

/* Enhanced Button Variants - Theme Responsive */
.retro-button-primary {
  background: linear-gradient(145deg, var(--primary), var(--secondary) 40%, var(--border));
  border-color: var(--border);
  color: var(--text-inverse);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.retro-button-primary::before {
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.4) 0%, 
    rgba(255, 255, 255, 0.2) 50%, 
    rgba(255, 255, 255, 0.4) 100%
  );
}

.retro-button-primary:hover {
  background: linear-gradient(145deg, #9CC822, #8AAE1F 40%, #7B951D);
}

.retro-button-primary:active {
  background: linear-gradient(145deg, #7B951D, #6B850D 40%, #1A1A2A);
}

.retro-button-danger {
  background: linear-gradient(145deg, var(--palm-red), #C0392B 40%, #A93226);
  border-color: var(--border);
  color: var(--text-inverse);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.retro-button-danger::before {
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.4) 0%, 
    rgba(255, 255, 255, 0.2) 50%, 
    rgba(255, 255, 255, 0.4) 100%
  );
}

.retro-button-danger:hover {
  background: linear-gradient(145deg, #FFB0D0, #EC90B0 40%, #DD7090);
}

.retro-button-danger:active {
  background: linear-gradient(145deg, #DD7090, #CC6080 40%, #1A1A2A);
}

.retro-button-secondary {
  background: linear-gradient(145deg, var(--secondary), var(--primary) 40%, var(--border));
  border-color: var(--border);
  color: var(--text-inverse);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.retro-button-secondary::before {
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.3) 0%, 
    rgba(255, 255, 255, 0.1) 50%, 
    rgba(255, 255, 255, 0.3) 100%
  );
}

.retro-button-secondary:hover {
  background: linear-gradient(145deg, #109090, #007676 40%, #005C5C);
}

.retro-button-secondary:active {
  background: linear-gradient(145deg, #005C5C, #004C4C 40%, #1A1A2A);
}

/* Button Sizes */
.retro-button-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.625rem;
  border-radius: 3px;
}

.retro-button-lg {
  padding: 0.75rem 1.5rem;
  font-size: 0.875rem;
  border-radius: 6px;
}

/* Device Navigation Tabs - Binder/Filing Cabinet Style */
.palm-device-tabs {
  display: flex;
  justify-content: space-between;
  padding: 8px 12px;
  background: linear-gradient(180deg, var(--palm-dark-gray) 0%, var(--palm-gray) 100%);
  border-top: 2px solid var(--border);
  position: relative;
}

.palm-device-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-width: 60px;
  height: 40px;
  background: linear-gradient(145deg, var(--button-face), var(--button-shadow));
  border: 2px solid var(--button-border);
  border-radius: 6px 6px 0 0;
  border-bottom: none;
  cursor: pointer;
  position: relative;
  transition: all 0.2s ease;
  box-shadow: 
    inset 1px 1px 2px rgba(255, 255, 255, 0.3),
    inset -1px -1px 2px rgba(0, 0, 0, 0.3),
    0 -2px 4px rgba(0, 0, 0, 0.4);
  margin: 0 2px;
}

.palm-device-tab:hover {
  transform: translateY(-2px);
  background: linear-gradient(145deg, var(--button-highlight), var(--button-face));
  box-shadow: 
    inset 1px 1px 2px rgba(255, 255, 255, 0.4),
    inset -1px -1px 2px rgba(0, 0, 0, 0.2),
    0 -4px 8px rgba(0, 0, 0, 0.5);
}

.palm-device-tab:active {
  transform: translateY(-1px);
  box-shadow: 
    inset 1px 1px 3px rgba(0, 0, 0, 0.4),
    inset -1px -1px 3px rgba(255, 255, 255, 0.1),
    0 -2px 4px rgba(0, 0, 0, 0.4);
}

.palm-device-tab-active {
  transform: translateY(-4px);
  background: linear-gradient(145deg, var(--primary), var(--secondary));
  box-shadow: 
    inset 1px 1px 2px rgba(255, 255, 255, 0.4),
    inset -1px -1px 2px rgba(0, 0, 0, 0.2),
    0 -6px 12px rgba(0, 0, 0, 0.6);
  z-index: 10;
}

.palm-device-tab-active .palm-device-tab-label {
  color: var(--text-inverse);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.palm-device-tab-icon {
  font-size: 12px;
  margin-bottom: 2px;
  filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.3));
}

.palm-device-tab-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 8px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-primary);
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.3);
}

/* Physical tab effect - like binder dividers */
.palm-device-tab::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  right: 2px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.4) 0%, 
    rgba(255, 255, 255, 0.2) 50%, 
    rgba(255, 255, 255, 0.4) 100%
  );
  border-radius: 2px 2px 0 0;
  pointer-events: none;
}

.palm-device-tab::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--background);
  border-radius: 0 0 4px 4px;
  pointer-events: none;
}

.palm-device-tab-active::after {
  background: var(--surface);
  height: 4px;
  bottom: -4px;
}
.palm-button {
  background: var(--button-face);
  border: 2px solid var(--button-border);
  border-radius: 4px;
  padding: 8px 16px;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 500;
  font-size: 14px;
  color: var(--text-primary);
  cursor: pointer;
  position: relative;
  transition: all 0.1s ease;
  box-shadow: 
    2px 2px 0 var(--button-shadow),
    -2px -2px 0 var(--button-dark-shadow);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.palm-button:hover {
  background: var(--palm-beige);
  transform: translateY(1px);
  box-shadow: 
    1px 1px 0 var(--button-shadow),
    -1px -1px 0 var(--button-dark-shadow);
}

.palm-button:active {
  transform: translateY(2px);
  box-shadow: 
    inset 1px 1px 2px rgba(0,0,0,0.3),
    0 0 0;
}

.palm-button.primary {
  background: var(--palm-green);
  color: var(--text-inverse);
  border-color: var(--palm-dark-green);
}

.palm-button.secondary {
  background: var(--palm-blue);
  color: var(--text-inverse);
  border-color: #3A7BC8;
}

.palm-button.danger {
  background: var(--palm-red);
  color: var(--text-inverse);
  border-color: #C0392B;
}

/* Enhanced Retro Input Fields - Recessed Physical Feel */
.retro-input {
  background: linear-gradient(145deg, var(--surface), var(--background));
  border: 2px solid var(--border);
  border-radius: 4px;
  padding: 0.5rem 0.75rem;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.875rem;
  color: var(--text-primary);
  box-shadow: 
    inset 2px 2px 4px rgba(0, 0, 0, 0.6),
    inset -1px -1px 2px rgba(255, 255, 255, 0.1),
    0 1px 2px rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
  outline: none;
  position: relative;
}

.retro-input::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  right: 2px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(0, 0, 0, 0.3) 0%, 
    rgba(0, 0, 0, 0.1) 50%, 
    rgba(0, 0, 0, 0.3) 100%
  );
  pointer-events: none;
}

.retro-input::after {
  content: '';
  position: absolute;
  bottom: 2px;
  left: 2px;
  right: 2px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.1) 0%, 
    rgba(255, 255, 255, 0.2) 50%, 
    rgba(255, 255, 255, 0.1) 100%
  );
  pointer-events: none;
}

.retro-input:focus {
  background: linear-gradient(145deg, #c8c8c8, #b0b0b0);
  border-color: #1a40a8;
  box-shadow: 
    inset 2px 2px 4px rgba(0, 0, 0, 0.7),
    inset -1px -1px 2px rgba(255, 255, 255, 0.1),
    0 0 0 3px rgba(26, 64, 168, 0.3),
    0 1px 2px rgba(0, 0, 0, 0.4);
}

.retro-input::placeholder {
  color: var(--text-secondary);
  font-style: italic;
  opacity: 0.8;
}

.retro-textarea {
  background: linear-gradient(145deg, var(--surface), var(--background));
  border: 2px solid var(--border);
  border-radius: 4px;
  padding: 0.5rem 0.75rem;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.875rem;
  color: var(--text-primary);
  box-shadow: 
    inset 2px 2px 4px rgba(0, 0, 0, 0.6),
    inset -1px -1px 2px rgba(255, 255, 255, 0.1),
    0 1px 2px rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
  outline: none;
  position: relative;
  resize: vertical;
  min-height: 80px;
}

.retro-textarea::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  right: 2px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(0, 0, 0, 0.3) 0%, 
    rgba(0, 0, 0, 0.1) 50%, 
    rgba(0, 0, 0, 0.3) 100%
  );
  pointer-events: none;
}

.retro-textarea::after {
  content: '';
  position: absolute;
  bottom: 2px;
  left: 2px;
  right: 2px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.1) 0%, 
    rgba(255, 255, 255, 0.2) 50%, 
    rgba(255, 255, 255, 0.1) 100%
  );
  pointer-events: none;
}

.retro-textarea:focus {
  background: linear-gradient(145deg, #c8c8c8, #b0b0b0);
  border-color: #1a40a8;
  box-shadow: 
    inset 2px 2px 4px rgba(0, 0, 0, 0.7),
    inset -1px -1px 2px rgba(255, 255, 255, 0.1),
    0 0 0 3px rgba(26, 64, 168, 0.3),
    0 1px 2px rgba(0, 0, 0, 0.4);
}

.retro-textarea::placeholder {
  color: var(--text-secondary);
  font-style: italic;
  opacity: 0.8;
}

/* Enhanced Retro Cards - Physical Container Feel */
.retro-card {
  background: linear-gradient(145deg, var(--surface), var(--background));
  border: 2px solid var(--border);
  border-radius: 6px;
  padding: 0.75rem;
  box-shadow: 
    inset 1px 1px 2px rgba(255, 255, 255, 0.6),
    inset -1px -1px 2px rgba(0, 0, 0, 0.3),
    3px 3px 6px rgba(0, 0, 0, 0.5),
    -1px -1px 3px rgba(255, 255, 255, 0.3);
  position: relative;
}

.retro-card::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  right: 2px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.6) 0%, 
    rgba(255, 255, 255, 0.3) 50%, 
    rgba(255, 255, 255, 0.6) 100%
  );
  border-radius: 4px 4px 0 0;
  pointer-events: none;
}

.retro-card::after {
  content: '';
  position: absolute;
  bottom: 2px;
  left: 2px;
  right: 2px;
  height: 1px;
  background: linear-gradient(90deg, 
    rgba(0, 0, 0, 0.3) 0%, 
    rgba(0, 0, 0, 0.2) 50%, 
    rgba(0, 0, 0, 0.3) 100%
  );
  border-radius: 0 0 4px 4px;
  pointer-events: none;
}

.retro-card.inset {
  background: linear-gradient(145deg, #a0a0a0, #888888);
  border-color: #404040;
  box-shadow: 
    inset 2px 2px 4px rgba(0, 0, 0, 0.6),
    inset -1px -1px 2px rgba(255, 255, 255, 0.1),
    0 1px 2px rgba(0, 0, 0, 0.3);
}

.retro-card.inset::before {
  background: linear-gradient(90deg, 
    rgba(0, 0, 0, 0.3) 0%, 
    rgba(0, 0, 0, 0.1) 50%, 
    rgba(0, 0, 0, 0.3) 100%
  );
}

.retro-card.inset::after {
  background: linear-gradient(90deg, 
    rgba(255, 255, 255, 0.1) 0%, 
    rgba(255, 255, 255, 0.2) 50%, 
    rgba(255, 255, 255, 0.1) 100%
  );
}

/* Retro card/container */
.palm-card {
  background: var(--button-face);
  border: 2px solid var(--button-border);
  border-radius: 6px;
  padding: 12px;
  box-shadow: 
    2px 2px 0 var(--button-shadow),
    -2px -2px 0 var(--button-dark-shadow);
}

.palm-card.inset {
  box-shadow: inset 2px 2px 4px rgba(0,0,0,0.2);
}

/* Retro tabs */
.palm-tabs {
  display: flex;
  background: var(--button-dark-shadow);
  border-radius: 6px 6px 0 0;
  padding: 4px;
  gap: 2px;
}

.palm-tab {
  background: var(--button-face);
  border: 2px solid var(--button-border);
  border-radius: 4px 4px 0 0;
  padding: 8px 16px;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 500;
  font-size: 12px;
  color: var(--text-secondary);
  cursor: pointer;
  position: relative;
  transition: all 0.1s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.palm-tab.active {
  background: var(--screen-bg);
  color: var(--text-primary);
  border-bottom-color: var(--screen-bg);
  transform: translateY(-2px);
}

.palm-tab:hover:not(.active) {
  background: var(--palm-beige);
}

/* Retro list items */
.palm-list-item {
  background: var(--button-face);
  border: 1px solid var(--button-border);
  border-radius: 4px;
  padding: 8px 12px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.1s ease;
}

.palm-list-item:hover {
  background: var(--palm-beige);
  border-color: var(--palm-dark-gray);
}

.palm-list-item.completed {
  opacity: 0.6;
  text-decoration: line-through;
}

/* Retro icons (using Unicode symbols for that authentic feel) */
.palm-icon {
  font-family: 'VT323', monospace;
  font-size: 18px;
  line-height: 1;
}

/* Retro status bar */
.palm-status-bar {
  background: linear-gradient(180deg, #9a9a9a 0%, #7a7a7a 50%, #6a6a6a 100%);
  border-bottom: 2px solid #404040;
  padding: 0.5rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.875rem;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  box-shadow: 
    inset 0 2px 4px rgba(255, 255, 255, 0.3),
    inset 0 -2px 4px rgba(0, 0, 0, 0.6),
    0 2px 2px rgba(0, 0, 0, 0.4);
  position: relative;
  z-index: 2;
}

.palm-status-bar::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(255, 255, 255, 0.4) 20%, 
    rgba(255, 255, 255, 0.4) 80%, 
    transparent 100%
  );
}

/* App Window Container - BlackBerry Theme */
.palm-app-window {
  background: linear-gradient(180deg, #005387 0%, #003d66 50%, #002944 100%);
  border: 2px solid #002944;
  border-radius: 4px;
  margin: 0.5rem;
  box-shadow: 
    inset 0 2px 6px rgba(255, 255, 255, 0.1),
    inset 0 -2px 6px rgba(0, 0, 0, 0.8),
    0 4px 8px rgba(0, 0, 0, 0.6),
    0 0 0 1px #005387;
  position: relative;
  overflow: hidden;
}

.palm-app-window::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(255, 255, 255, 0.2) 10%, 
    rgba(255, 255, 255, 0.2) 90%, 
    transparent 100%
  );
}

.palm-app-window::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(0, 0, 0, 0.4) 10%, 
    rgba(0, 0, 0, 0.4) 90%, 
    transparent 100%
  );
}

/* App Content Area - Theme Responsive */
.palm-app-content {
  background: linear-gradient(180deg, var(--surface) 0%, var(--background) 100%);
  padding: 0;
  height: 400px;
  overflow-y: auto;
  position: relative;
}

.palm-app-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      rgba(0, 0, 0, 0.02) 1px,
      rgba(0, 0, 0, 0.02) 2px
    ),
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 1px,
      rgba(0, 0, 0, 0.02) 1px,
      rgba(0, 0, 0, 0.02) 2px
    );
  pointer-events: none;
  z-index: 1;
}

.retro-screen {
  background: #D1D5D8;
  border: 2px solid #002944;
  border-radius: 4px;
  box-shadow: 
    inset 3px 3px 8px rgba(0, 0, 0, 0.6),
    inset -1px -1px 3px rgba(255, 255, 255, 0.1),
    0 0 0 1px #005387;
  overflow: hidden;
  position: relative;
  height: 500px; /* Fixed height: header(60px) + content(400px) */
}

.retro-screen::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      rgba(0, 0, 0, 0.03) 1px,
      rgba(0, 0, 0, 0.03) 2px
    ),
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 1px,
      rgba(0, 0, 0, 0.03) 1px,
      rgba(0, 0, 0, 0.03) 2px
    );
  pointer-events: none;
  z-index: 1;
}

/* App Header - BlackBerry Theme */
.palm-app-header {
  background: transparent;
  border-bottom: 2px solid #002944;
  padding: 0.75rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.15em;
  color: #FFFFFF;
  text-shadow: 
    0 1px 2px rgba(0, 0, 0, 0.9),
    0 -1px 1px rgba(255, 255, 255, 0.1);
  position: relative;
  z-index: 2;
}

.palm-app-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(255, 255, 255, 0.3) 10%, 
    rgba(255, 255, 255, 0.3) 90%, 
    transparent 100%
  );
}

.palm-app-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(180deg, 
    rgba(255, 255, 255, 0.2) 0%, 
    transparent 100%
  );
}

.palm-app-title {
  color: #FFD93D;
  font-weight: 800;
  text-transform: uppercase;
  text-shadow: 
    0 2px 4px rgba(0, 0, 0, 0.9),
    0 0 8px rgba(255, 217, 61, 0.3);
}

/* Enhanced Etched Device Title */
.palm-device-title {
  background: linear-gradient(135deg, #6a6a6a 0%, #4a4a4a 50%, #3a3a3a 100%);
  border: 2px solid #2a2a2a;
  padding: 0.25rem 0.75rem;
  border-radius: 0.25rem;
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
  color: #e0e0e0;
  text-shadow: 
    inset 1px 1px 2px rgba(0, 0, 0, 0.8),
    1px 1px 0px rgba(255, 255, 255, 0.1);
  box-shadow: 
    inset 0 2px 4px rgba(0, 0, 0, 0.6),
    inset 0 -1px 2px rgba(255, 255, 255, 0.1),
    0 2px 2px rgba(0, 0, 0, 0.4);
  position: relative;
}

.palm-device-title::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(255, 255, 255, 0.2) 50%, 
    transparent 100%
  );
}

/* Enhanced Palm Logo */
.palm-logo {
  font-size: 1.25rem;
  filter: grayscale(100%) brightness(0.8) contrast(1.2);
  opacity: 0.9;
  text-shadow: 
    2px 2px 4px rgba(0, 0, 0, 0.8),
    0 0 4px rgba(0, 0, 0, 0.4);
  transform: translateY(-1px);
}

/* AI suggestion styling */
.palm-ai-suggestion {
  background: linear-gradient(135deg, var(--retro-surface) 0%, var(--retro-background) 100%);
  border: 2px solid var(--retro-primary);
  box-shadow: 
    inset 0 2px 4px rgba(255, 255, 255, 0.1),
    0 4px 8px rgba(0, 0, 0, 0.2);
  position: relative;
}

.palm-ai-suggestion::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 10px,
    var(--retro-primary) 10px,
    var(--retro-primary) 11px
  );
  opacity: 0.1;
  border-radius: inherit;
  pointer-events: none;
}

.palm-device-title::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 2px,
    rgba(0, 0, 0, 0.1) 2px,
    rgba(0, 0, 0, 0.1) 3px
  );
  border-radius: 0.25rem;
  pointer-events: none;
}

.palm-checkbox {
  appearance: none;
  width: 16px;
  height: 16px;
  border: 2px solid var(--button-border);
  background: var(--button-face);
  border-radius: 2px;
  position: relative;
  cursor: pointer;
  margin-right: 8px;
}

.palm-checkbox:checked::before {
  content: '✓';
  position: absolute;
  top: -2px;
  left: 2px;
  font-size: 14px;
  color: var(--palm-dark-green);
  font-weight: bold;
}

/* Retro scrollbar */
.palm-scrollbar::-webkit-scrollbar {
  width: 12px;
}

.palm-scrollbar::-webkit-scrollbar-track {
  background: var(--button-dark-shadow);
  border-radius: 6px;
}

.palm-scrollbar::-webkit-scrollbar-thumb {
  background: var(--button-border);
  border-radius: 6px;
  border: 1px solid var(--button-face);
}

.palm-scrollbar::-webkit-scrollbar-thumb:hover {
  background: var(--palm-gray);
}

/* Main Retro Device Container */
.retro-device {
  width: 100%;
  max-width: 600px;
  height: auto;
  background: var(--background);
  border-radius: 12px;
  box-shadow: 
    0 8px 32px rgba(0, 0, 0, 0.3),
    0 4px 16px rgba(0, 0, 0, 0.2);
  overflow: hidden;
  position: relative;
}

/* Retro grid layout */
.palm-grid {
  display: grid;
  gap: 8px;
}

.palm-grid-2 {
  grid-template-columns: 1fr 1fr;
}

.palm-grid-3 {
  grid-template-columns: 1fr 1fr 1fr;
}

/* Retro modal/dialog */
.palm-modal {
  background: var(--button-face);
  border: 3px solid var(--button-border);
  border-radius: 8px;
  padding: 16px;
  box-shadow: 
    4px 4px 0 var(--button-shadow),
    -4px -4px 0 var(--button-dark-shadow),
    0 0 0 2px rgba(0,0,0,0.8);
  position: relative;
}

.palm-modal::before {
  content: '';
  position: absolute;
  top: -1px;
  left: -1px;
  right: -1px;
  bottom: -1px;
  background: linear-gradient(45deg, var(--palm-gray), var(--button-border));
  border-radius: 8px;
  z-index: -1;
}

/* Responsive retro design */
@media (max-width: 640px) {
  .palm-device {
    border-radius: 12px;
    padding: 8px;
  }
  
  .palm-screen {
    min-height: 500px;
    border-radius: 6px;
  }
  
  .palm-button {
    padding: 6px 12px;
    font-size: 12px;
  }
  
  .palm-input, .palm-textarea {
    font-size: 12px;
    padding: 6px 10px;
  }
}
